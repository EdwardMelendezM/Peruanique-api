// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PROFESSIONAL
}

enum QuestionType {
  MULTIPLE_CHOICE
  DRAG_AND_DROP
}

enum ProgressStatus {
  LOCKED
  IN_PROGRESS
  COMPLETED
}

// --- Modelos ---

model User {
  id            String  @id @default(uuid())
  email         String  @unique
  emailVerified Boolean @default(false)
  password      String? // Opcional si solo usas OAuth
  full_name     String
  name          String? // Para el nombre de usuario o nombre corto
  image         String? // Para la foto de perfil de Google/FB

  // Estado de usuario
  is_disabled Boolean @default(false)

  // Campos de Gamificación FIJA
  birthday           DateTime?
  daily_goal_minutes Int       @default(15)
  total_xp           Int       @default(0)
  streak_days        Int       @default(0)
  current_energy     Int       @default(5)

  // Relaciones de Auth
  sessions Session[]
  accounts Account[]

  // Relaciones de App
  profile        UserProfile?
  progress       UserProgress[]
  schedules      DailySchedule[]
  // Intentos y eventos
  lessonAttempts LessonAttempt[]
  rewardEvents   RewardEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([total_xp(sort: Desc)])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?   @db.Text
  password              String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@map("verifications")
}

model UserProfile {
  id                String @id @default(uuid())
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String @unique
  target_university String
  target_major      String
  current_level_tag String @default("novato")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_profiles")
}

model Course {
  id          String  @id @default(uuid())
  name        String
  color_theme String?
  icon_url    String?

  nodes RoadmapNode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("courses")
}

model RoadmapNode {
  id               String     @id @default(uuid())
  course           Course     @relation(fields: [courseId], references: [id])
  courseId         String
  title            String
  order_index      Int
  difficulty_level Difficulty @default(BEGINNER)
  is_boss_level    Boolean    @default(false)

  questions       Question[]
  user_progress   UserProgress[]
  lesson_attempts LessonAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, order_index])
  @@map("roadmap_nodes")
}

model Question {
  id               String       @id @default(uuid())
  node             RoadmapNode  @relation(fields: [nodeId], references: [id])
  nodeId           String
  question_text    String       @db.Text
  explanation_text String?      @db.Text
  difficulty       Difficulty   @default(BEGINNER)
  question_type    QuestionType @default(MULTIPLE_CHOICE)

  answers         Answer[]
  lesson_attempts LessonAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("questions")
}

model Answer {
  id          String   @id @default(uuid())
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId  String
  answer_text String   @db.Text
  is_correct  Boolean  @default(false)

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  selected_in_attempts LessonAttempt[] @relation("SelectedAnswerRelation")

  @@map("answers")
}

model UserProgress {
  id             String         @id @default(uuid())
  user           User           @relation(fields: [userId], references: [id])
  userId         String
  node           RoadmapNode    @relation(fields: [nodeId], references: [id])
  nodeId         String
  status         ProgressStatus @default(LOCKED)
  score_obtained Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, nodeId])
  @@map("user_progress")
}

model DailySchedule {
  id             String   @id @default(uuid())
  user           User     @relation(fields: [userId], references: [id])
  userId         String
  preferred_hour DateTime
  days_of_week   Int[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("daily_schedules")
}

model LessonAttempt {
  id                 String       @id @default(uuid())
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  node               RoadmapNode? @relation(fields: [nodeId], references: [id])
  nodeId             String?
  question           Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId         String
  selectedAnswer     Answer?      @relation("SelectedAnswerRelation", fields: [selectedAnswerId], references: [id])
  selectedAnswerId   String?
  is_correct         Boolean      @default(false)
  time_spent_seconds Int?
  answered_at        DateTime     @default(now())

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  ai_explanations AiExplanation[]

  @@map("lesson_attempts")
}

model RewardEvent {
  id           String   @id @default(uuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  type         String
  points_delta Int
  coins_delta  Int
  meta         Json?
  createdAt    DateTime @default(now())

  @@map("reward_events")
}

model AiExplanation {
  id            String        @id @default(uuid())
  attempt       LessonAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId     String
  provider      String
  model         String
  input_tokens  Int?
  output_tokens Int?
  latency_ms    Int?
  content       Json
  createdAt     DateTime      @default(now())

  @@map("ai_explanations")
}
